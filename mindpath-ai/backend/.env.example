# Vercel AI Gateway integration
# Create a key in Vercel Dashboard -> AI Gateway -> API Keys.
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here

# Use provider/model format supported by Vercel AI Gateway.
# Example: openai/gpt-4o-mini, openai/gpt-5.2, anthropic/claude-sonnet-4.6
AI_GATEWAY_MODEL=openai/gpt-4o-mini

# Auth token signing secret
# MINDPATH_TOKEN_SECRET=mindpath-local-secret
